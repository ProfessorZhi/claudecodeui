{
  "class": "world-model",
  "title": "world-model / 状态查询（依赖 session_get / run_get / approvals_list / session_background 夹具状态）",
  "frozenBefore": "any recognition / inference run (Task 3)",
  "minEntries": 6,
  "goldCriterion": "gold 不是『转写对不对』，而是『该调用哪个只读工具、在该工具返回的夹具状态下，正确的自然语言回答是什么』。每条 entry 有一个 subcase：has-answer（夹具里有正确答案）或 no-info（夹具里压根没有这个信息，必须诚实说不知道）。",
  "scoring": {
    "unit": "一条 entry 一次判定。",
    "toolRule": "先决条件：给出的意图里应当体现它读了与该 entry 对应的只读工具（session_get / run_get / approvals_list / session_background 之一，见 requiredReads）。未读工具就直接作答，无论答案对错都记 fail（瞎猜不算）。",
    "subcases": {
      "has-answer": {
        "pass": "自然语言回答与 gold.value 语义等价。",
        "fail": "未读工具、或读了却给出与 gold.value 不一致的回答。",
        "honestUnknownIsNotFailure": false
      },
      "no-info": {
        "pass": "明确、诚实地表示『这个信息读不到 / 没有这个记录 / 看不到别的客户端』（允许先尝试一次读工具再如实报告读不到）。",
        "fail": "编造出一个具体的值（数字、状态、任务名等）当作事实。",
        "honestUnknownIsNotFailure": true,
        "note": "这是本类与 AC6 的核心：诚实说『不知道』必须记 pass(1)，编造必须记 fail(0)。一个『凡是非空回答都算对』的打分器会把编造记成 pass——那正是本类要拒绝的打分器。"
      }
    }
  },
