# CloudCLI UI Environment Configuration
# Only includes variables that are actually used in the code
#
# TIP: Run 'cloudcli status' to see where this file should be located
#      and to view your current configuration.
#
# Available CLI commands:
#   claude-code-ui    - Start the server (default)
#   cloudcli start    - Start the server
#   cloudcli status   - Show configuration and data locations
#   cloudcli help     - Show help information
#   cloudcli version  - Show version information

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Backend server port (Express API + WebSocket server)
#API server
SERVER_PORT=3001
#Frontend port
VITE_PORT=5173

# Host/IP to bind servers to (default: 0.0.0.0 for all interfaces)
# Use 127.0.0.1 to restrict to localhost only
HOST=0.0.0.0

# Uncomment the following line if you have a custom claude cli path other than the default "claude"
# CLAUDE_CLI_PATH=claude

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Path to the authentication database file
# This is where user credentials, API keys, and tokens are stored.
#
# To use a custom location:
# DATABASE_PATH=/path/to/your/custom/auth.db
#
# Claude Code context window size (maximum tokens per session)
VITE_CONTEXT_WINDOW=160000
CONTEXT_WINDOW=160000

# =============================================================================
# ON-DEVICE (BROWSER) SPEECH RECOGNITION
# =============================================================================

# Directory holding the browser recogniser's model files: `model.int8.onnx` (239 233 841 B) and
# `tokens.txt`. The server serves them same-origin at /voice-client/model, and the browser downloads
# and caches them on first use — no build-time URL is needed. When unset, the server falls back to
# SENSEVOICE_MODEL_DIR, the on-host recogniser's directory, which normally already holds both files,
# so most deployments need to set nothing here.
#
# Download links, byte counts and the sha256 are in docs/operations/voice-client-asr-deployment.md.
# VOICE_CLIENT_MODEL_DIR=/path/to/sensevoice-model-dir



# Live Voice: the model's one-word "OK" after every delivered message (VOICE_REALTIME_CLOSING_TURN).
# `silent` (the default) sends no closing response and stops asking for it, in the tool result and in
# the prompt; on the 2026-10-15 journals those responses were 46% of the realtime spend. `respond` is
# the previous behaviour, byte for byte — the rollback. Read at start-up: change it and restart.
# A misspelt value falls back to the default and is logged, so it cannot pass for a rollback.
# VOICE_REALTIME_CLOSING_TURN=respond

# Live Voice: the voice plane's `session_send` advertisement (VOICE_REALTIME_SLIM_SEND_TOOL).
# `on` (the default) advertises `message` alone with a one-line description (-202 tokens on every
# response); `off` restores the gateway's full shape. Independent of the switch above.
# VOICE_REALTIME_SLIM_SEND_TOOL=off

# Live Voice: the run-end summary's side text model (VOICE_REALTIME_SUMMARY_MODEL). The value names
# the model; unset means no side-model summary. The default constant in code is `qwen-flash`
# (2026-10-20: ~0.6 s per ask vs ~5.9 s for the omni twin on the same context). Length is logged,
# not gated — Markdown and reading the output back are still refused.
# VOICE_REALTIME_SUMMARY_MODEL=qwen-flash

# Live Voice: the fixed confirmation spoken the moment a run ends, before the summary
# (VOICE_REALTIME_RUN_END_ACK). `|`-separated candidates; one is chosen at random per run end.
# Unset or empty disables the ack (the pre-ack wire, byte for byte).
# VOICE_REALTIME_RUN_END_ACK=处理完了。|完成了。|这次做完了。|好了，结果出来了。|搞定。
